FROM registry.access.redhat.com/ubi8/ubi:8.5-214

# Install Python and vulnerable application packages for ACS detection
RUN dnf install -y python39 && \
    python3 -m pip install --no-cache-dir \
    requests==2.19.1 \
    urllib3==1.24 \
    pyyaml==3.12 \
    jinja2==2.10

WORKDIR /app

# Write http.server application
RUN printf "import http.server\nimport socketserver\n\nPORT = 8080\nHandler = http.server.SimpleHTTPRequestHandler\n\nwith socketserver.TCPServer(('', PORT), Handler) as httpd:\n    print('Serving on port', PORT)\n    httpd.serve_forever()\n" > app.py

EXPOSE 8080
USER 1001
CMD ["python3", "app.py"]
